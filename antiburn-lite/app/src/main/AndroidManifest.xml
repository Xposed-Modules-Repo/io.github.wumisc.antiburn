<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 枚举已安装应用（白名单选择界面）：Android 11+ 包可见性需要此权限，
         HyperOS 上表现为"获取应用列表"运行时授权弹窗。 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Android 11+ 包可见性兜底：即使部分 ROM 不授予「获取应用列表」，
         至少能列出带桌面入口的应用，白名单选择页不会一片空白。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Shizuku：Android 11+ 不声明就查不到这个包，运行方式卡片会一直显示「未安装」 -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".AbApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AntiburnLite">

        <!-- 主界面：3 Tab（首页/功能/关于）+ Kyant0 液态玻璃导航栏 + 真实防烧屏开关 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 白名单图形化选择：搜索+勾选应用，避免手动填包名。居中小窗，不占全屏 -->
        <activity
            android:name=".WhitelistPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.AntiburnLite.Dialog" />

        <!-- 快捷开关磁贴：点击改写 enable_status，模块周期轮询一个周期内生效 -->
        <service
            android:name=".AntiburnTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 免 root 遮盖引擎（线路 A）。必须由用户在系统设置里手动开启，或走线路 B 的
             Shizuku 授权代开；BIND_ACCESSIBILITY_SERVICE 保证只有系统能绑定它。 -->
        <service
            android:name=".BurnInMaskService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 线路 B：Shizuku 的 binder 中继。没有它，普通应用拿不到 Shizuku 的 binder，
             checkSelfPermission / newProcess 全部不可用。authorities 必须以 applicationId
             开头，Shizuku 按这个规则反查调用方。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            tools:ignore="ProtectedPermissions" />

        <!-- 被 Hook 的进程无法直接读 /data/local/tmp（SELinux shell_data_file），
             通过此导出的 provider 读取「应用内镜像」配置文本，设置才能真正生效。
             只暴露一小段开关文本，不提供 query/insert/update/delete。 -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="io.github.wumisc.antiburn.config"
            android:exported="true" />

        <!--
          LSPosed 模块声明：隐藏功能在 SystemUI / 抖音 / 红果 / 快手 / B站 进程内 Hook 生效。
          v2.6.8：快手 / B站 正式接入周期隐藏，xposeddescription 如实描述已支持的两个应用。
        -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="防 OLED 烧屏：周期性隐藏状态栏/导航栏与抖音、红果短剧、快手、哔哩哔哩各区域，像素微移内置常开。提供 LSPosed（需 root 与框架，真隐藏）与无障碍遮盖（免 root，触摸穿透）两种运行方式；App 内固定控件采用位置微移：右侧按钮列、顶部标题、底部导航整体平移 2~3 像素、每 8 秒换向，画面完整可见、点击照常，进直播间自动还原；不再使用遮盖层，因此不会遮挡视频画面。按小米 HyperOS、荣耀 MagicOS、OPPO ColorOS、vivo OriginOS、华为 HarmonyOS、魅族 Flyme 与原生 AOSP 分别适配胶囊、环形电池与导航栏结构。支持白名单、周期时长、感谢名单与支持捐赠；所有开关在 App 内即时保存。" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>

</manifest>

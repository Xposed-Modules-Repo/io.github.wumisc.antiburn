<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 枚举已安装应用（白名单选择界面）：Android 11+ 包可见性需要此权限，
         HyperOS 上表现为"获取应用列表"运行时授权弹窗。 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Android 11+ 包可见性兜底：即使部分 ROM 不授予「获取应用列表」，
         至少能列出带桌面入口的应用，白名单选择页不会一片空白。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AbApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AntiburnLite">

        <!-- 主界面：3 Tab（首页/功能/关于）+ Kyant0 液态玻璃导航栏 + 真实防烧屏开关 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 白名单图形化选择：搜索+勾选应用，避免手动填包名。居中小窗，不占全屏 -->
        <activity
            android:name=".WhitelistPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.AntiburnLite.Dialog" />

        <!-- 快捷开关磁贴：点击改写 enable_status，模块周期轮询一个周期内生效 -->
        <service
            android:name=".AntiburnTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 被 Hook 的进程无法直接读 /data/local/tmp（SELinux shell_data_file），
             通过此导出的 provider 读取「应用内镜像」配置文本，设置才能真正生效。
             只暴露一小段开关文本，不提供 query/insert/update/delete。 -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="io.github.wumisc.antiburn.config"
            android:exported="true" />

        <!-- LSPosed 模块声明：功能在 SystemUI / 抖音 / 红果进程内 Hook 生效 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="防 OLED 烧屏：像素微移 + 周期性隐藏状态栏/导航栏/抖音各区域，按小米 HyperOS、荣耀 MagicOS、OPPO ColorOS、vivo OriginOS、华为 HarmonyOS 与原生 AOSP 分别适配胶囊与导航栏结构。支持白名单、隐藏时长、励志古诗；所有开关在 App 内即时保存。" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      LSPosed 作用域：SystemUI（状态栏/导航栏）+ 抖音 + 红果短剧（国内/谷歌版）
      + 快手 + 哔哩哔哩（v2.6.8 正式接入，复用 DouyinHook 几何识别做周期隐藏）。

      v2.6.8：快手 / B站 由 DouyinHook 按「各自总开关 + 共用区域开关」隐藏，
      遮盖引擎下整体让位；VideoAppProbe 仅在诊断日志开启时导出 View 树供精调。
      加入作用域后，用户需在 LSPosed 管理器重新勾选新增的两项并重启，
      否则不会注入（v2.6.1 已踩过「作用域没勾导致 lsp 模式不可用」）。

      v2.8.0：真机日志实证用户 OPPO ColorOS 设备装的抖音是
      com.ss.android.ugc.aweme.mobile、B站是 com.bilibili.app.in —— 都不在旧的 6 项清单里，
      LSPosed 因此不注入这两个进程，App 内分区隐藏 100% 失效。现已把渠道包 / 极速版 /
      HD / 概念版一并登记。xposed_scope 只是「推荐作用域」，LSPosed 会与设备上已安装的
      应用取交集展示，列出未安装的项不会造成无谓注入；若你的包名仍不在列表，请在
      LSPosed 管理器里对本模块手动勾选该应用（VideoApps 已用前缀匹配覆盖绝大多数变体）。
    -->
    <string-array name="xposed_scope">
        <item>com.android.systemui</item>
        <!-- 抖音：主包 + 真机实证的渠道包 .mobile（OPPO）+ 极速版 -->
        <item>com.ss.android.ugc.aweme</item>
        <item>com.ss.android.ugc.aweme.mobile</item>
        <item>com.ss.android.ugc.aweme.lite</item>
        <!-- 红果短剧：国内版 + 谷歌版 -->
        <item>com.phoenix.read</item>
        <item>com.phoenix.read.oversea.gp</item>
        <!-- 快手：主包 + 极速版 -->
        <item>com.smile.gifmaker</item>
        <item>com.kuaishou.nebula</item>
        <!-- 哔哩哔哩：主包 + 真机实证的渠道包 com.bilibili.app.in（OPPO）+ HD + 概念版 + 国际版 -->
        <item>tv.danmaku.bili</item>
        <item>com.bilibili.app.in</item>
        <item>tv.danmaku.bilibilihd</item>
        <item>com.bilibili.app.blue</item>
    </string-array>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  无障碍服务声明。

  - accessibilityEventTypes 只要 typeWindowStateChanged：遮盖引擎靠它跟踪前台包名做名单判定，
    其它事件（点击、滚动）一律不收，减少对系统的事件分发负担。
  - canRetrieveWindowContent 必须为 true：要读系统栏窗口的真实 bounds（刘海、横屏侧边三键
    靠它才能盖准）。代价是设置页会显示「可读取屏幕内容」的提示，属这一能力的固有说明。
  - accessibilityFlags 里 flagRetrieveInteractiveWindows 是 getWindows() 生效的前提，
    少了它拿不到 AccessibilityWindowInfo，只能退回资源里猜高度。
  - notificationTimeout 给 100ms：窗口切换事件本身不密集，100ms 合并足够且更省电。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="100"
    android:settingsActivity="io.github.wumisc.antiburn.MainActivity" />

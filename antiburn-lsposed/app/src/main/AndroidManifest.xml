<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 枚举已安装应用（黑名单选择界面）：Android 11+ 包可见性需要此权限，
         HyperOS 上表现为"获取应用列表"运行时授权弹窗 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="防止烧屏"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.Antiburn">

        <!-- 配置界面：INFO 入口（无桌面图标），从 LSPosed Manager 打开 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Antiburn">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!-- 桌面图标壳：默认禁用（隐藏图标），配置页开关可启用 -->
        <activity
            android:name=".IconActivity"
            android:enabled="false"
            android:exported="true"
            android:label="防止烧屏"
            android:theme="@style/Theme.Antiburn">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 黑名单图形化选择：搜索+勾选应用，避免手动填包名。居中小窗，不占全屏 -->
        <activity
            android:name=".WhitelistPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Antiburn.Dialog" />

        <!-- 快捷开关磁贴 -->
        <service
            android:name=".AntiburnTile"
            android:exported="true"
            android:icon="@drawable/ic_antiburn"
            android:label="防止烧屏"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- LSPosed 模块声明 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="周期性隐藏状态栏图标/导航栏/抖音视频页右侧按钮列防OLED烧屏，可在App内自定义隐藏时间与开关。隐藏图标不影响下拉通知与控制中心。" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>

</manifest>
